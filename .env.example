# ─── Football Ultimate · variables de entorno (servidor) ───────────────────
# Copia este archivo a `.env` en la raíz del repositorio y rellena los valores.
# Las claves NUNCA se envían al navegador: sólo las lee apps/server.

# API-Football (API-Sports) — proveedor principal de escudos, banderas y logos
# https://www.api-football.com/documentation-v3
APISPORTS_KEY=
APISPORTS_BASE_URL=https://v3.football.api-sports.io
APISPORTS_MEDIA_URL=https://media.api-sports.io

# TheSportsDB — proveedor secundario (fallback de escudos)
# "3" es la clave pública de pruebas documentada por TheSportsDB (cobertura limitada).
THESPORTSDB_KEY=3
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json

# Servidor
SERVER_PORT=8787
# Descargar recursos remotos automáticamente cuando falten (true/false)
ASSET_AUTO_FETCH=true
# Horas antes de reintentar una descarga fallida
ASSET_RETRY_HOURS=12

# PostgreSQL (opcional en esta fase; el juego funciona con el catálogo de demostración)
DATABASE_URL=postgres://football:football@localhost:5432/football_ultimate
